# ===== LLM (OpenAI-compatible) =====
# OpenAI:        LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# OpenRouter:    LLM_BASE_URL=https://openrouter.ai/api/v1 LLM_MODEL=<model-id>
# Ollama local:  LLM_BASE_URL=http://localhost:11434/v1    LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# ===== Embedding (chạy local, không cần key) =====
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ===== Đường dẫn =====
DB_PATH=data/chakra.db
DOCS_DIR=data/docs
UPLOADS_DIR=data/uploads
LOGS_DIR=logs

# ===== Tham số pipeline =====
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=5
RRF_K=60
MIN_SCORE=0.25
MAX_AGENT_TURNS=4
# ===== API/CORS =====
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ===== Ingestion =====
SUPPORTED_SUFFIXES=.md,.txt,.pdf
EMBED_BATCH_SIZE=16
# ===== Verification =====
SUPPORT_THRESHOLD=0.30

# ===== LangSmith observability (tracing + feedback; optional) =====
# Bật tracing: đặt LANGSMITH_TRACING=true + LANGSMITH_API_KEY.
# Không cấu hình → mọi hook tracing/feedback là no-op an toàn.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-...
# LANGSMITH_PROJECT=chakra_rag
