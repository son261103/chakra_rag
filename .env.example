# ===== KEK =====
ENCRYPTION_KEY=

# ===== Embedding =====
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ===== Đường dẫn =====
DB_PATH=data/chakra.db
DOCS_DIR=data/docs
UPLOADS_DIR=data/uploads
LOGS_DIR=logs

# ===== Tham số pipeline =====
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=5
RRF_K=60
MIN_SCORE=0.25
MAX_AGENT_TURNS=4
# ===== API/CORS =====
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ===== Ingestion =====
SUPPORTED_SUFFIXES=.md,.txt,.pdf
EMBED_BATCH_SIZE=16
# ===== Verification =====
SUPPORT_THRESHOLD=0.30

# ===== Observability (LangSmith) =====
# Bật để gửi trace về LangSmith. Không set/false → chạy hoàn toàn offline, không gửi gì.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chakra_rag
